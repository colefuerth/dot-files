
# custom paths that should be added to PATH, if they exist
cpaths=(
    "$HOME/.local/bin"
    "$HOME/.bin"
    "$HOME/.cargo/bin"
    "$HOME/.platformio/penv/bin"
    "/usr/local/bin"
    "$HOME/.platform-tools"
)
for p in "${cpaths[@]}"; do
    if [ -d "$p" ]; then
        export PATH="$PATH:$p"
    fi
done

# My Aliases
alias c="claude --effort ultracode"
alias cr="claude --effort ultracode --resume"
alias py='python3'
alias pip='python3 -m pip'
alias pip3='python3 -m pip'
alias pcp='time rsync --progress -ah'

alias please='sudo env PATH=$PATH FPATH=$FPATH '
