--- a/src/osx/btop_collect.cpp
+++ b/src/osx/btop_collect.cpp
@@ -1091,6 +1091,17 @@
 		if (Config::getB("show_battery") and has_battery)
 			current_bat = get_battery();
 
+		if (Config::getB("show_cpu_watts")) {
+			try {
+				SMCConnection smcCon;
+				float watts = smcCon.getCpuPower();
+				supports_watts = watts >= 0.0f;
+				if (supports_watts) cpu.usage_watts = watts;
+			} catch (const std::runtime_error &) {
+				supports_watts = false;
+			}
+		}
+
 		return cpu;
 	}
 }  // namespace Cpu
--- a/src/osx/smc.cpp
+++ b/src/osx/smc.cpp
@@ -101,6 +101,14 @@
 		return getSMCFloat(key);
 	}
 
+	float SMCConnection::getCpuPower() {
+		char pkey[] = SMC_KEY_PCLUSTER_POWER;
+		char ekey[] = SMC_KEY_ECLUSTER_POWER;
+		float p = getSMCFloat(pkey);
+		float e = getSMCFloat(ekey);
+		return (p < 0.0f or e < 0.0f) ? -1.0f : p + e;
+	}
+
 	// core means physical core in SMC, while in core map it's cpu threads :-/ Only an issue on hackintosh?
 	// this means we can only get the T per physical core
 	// another issue with the SMC API is that the key is always 4 chars -> what with systems with more than 9 physical cores?
