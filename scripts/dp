#!/usr/bin/env bash
# dd with a progress bar, e.g. writing an image to a USB stick or SD card.
set -euo pipefail

if [ $# -ne 2 ]; then
    echo "Usage: dp [input_file] [output_device]" >&2
    exit 1
fi

if [ ! -e "$1" ]; then
    echo "Input file not found: $1" >&2
    exit 1
fi

# fullblock: reads from the pipe come up short, and O_DIRECT writes need whole
# blocks. Without pipefail, a pv read error would still exit 0 if dd succeeded.
pv "$1" | dd of="$2" bs=4M iflag=fullblock oflag=direct conv=fsync
