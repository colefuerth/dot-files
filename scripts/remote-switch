#!/usr/bin/env bash
set -euo pipefail
IFS=$'\n\t'

usage() {
  # Not $0: once packaged, that is the .remote-switch-wrapped store path.
  echo "Usage: remote-switch -c CLOSURE -i [USER@]HOST [options]"
  echo "  -f, --flake       Path to the flake (default: '$(pwd)')"
  echo "  -s, --system      The system architecture for remote builds (i.e. aarch64-linux)"
  echo "  -c, --closure     Flake attribute of a nixos config's toplevel,"
  echo "                    e.g. nixosConfigurations.cole-pi.config.system.build.toplevel"
  echo "  -i, --ip-address  Remote machine: IP, [user@]hostname or ssh alias"
  echo "  -p, --password    sudo (and ssh) password on the remote machine (optional;"
  echo "                    without it, sudo prompts on the remote terminal if needed)"
  echo "  -a, --action      Action to perform (switch, build, boot, test; default: test)"
  echo "                    build only copies the closure; boot also reboots the remote"
  echo "  -r, --remote      Remote builder to use (default: none)"
  echo "  -h, --help        Display this help message"
}

flake="$(pwd)"
system=""
closure=""
ip_address=""
password=""
action="test"
remote_builder=""
while [[ $# -gt 0 ]]; do
  case $1 in
  "-f" | "--flake")
    shift
    flake="$1"
    shift
    ;;
  "-s" | "--system")
    shift
    system="$1"
    shift
    ;;
  "-c" | "--closure")
    shift
    closure="$1"
    shift
    ;;
  "-i" | "--ip-address")
    shift
    ip_address="$1"
    shift
    ;;
  "-p" | "--password")
    shift
    password="$1"
    shift
    ;;
  "-a" | "--action")
    shift
    action="$1"
    shift
    ;;
  "-r" | "--remote")
    shift
    remote_builder="$1"
    shift
    ;;
  "-h" | "--help")
    usage
    exit 0
    ;;
  *)
    echo "ERROR: Unrecognized option: $1"
    usage
    exit 1
    ;;
  esac
done

if [[ -n "${remote_builder}" ]]; then
  if [[ -z "${system}" ]]; then
    echo "ERROR: --system must be specified when using --remote for remote builds"
    usage
    exit 1
  fi
  if [[ "${system}" != "aarch64-linux" ]] && [[ "${system}" != "x86_64-linux" ]]; then
    echo "ERROR: system must be one of <aarch64-linux|x86_64-linux>, received: \"${system}\""
    usage
    exit 1
  fi
fi

if [ "${closure}" == "" ]; then
  echo "ERROR: closure must be specified with -c CLOSURE"
  usage
  exit 1
fi

if [ "${ip_address}" == "" ]; then
  echo "ERROR: ip_address must be specified with -i IP_ADDRESS"
  usage
  exit 1
fi

if [ "${action}" != "switch" ] && [ "${action}" != "build" ] && [ "${action}" != "boot" ] && [ "${action}" != "test" ]; then
  echo "ERROR: action must be one of <switch|build|boot|test>, received: \"${action}\""
  usage
  exit 1
fi

closureToplevel="${flake}#${closure}"
echo "executing \"rebuild ${action}\" on ${ip_address} with closure \"${closureToplevel}\""

if [ "${remote_builder}" == "" ]; then
  closurePath=$(
    nom build \
      --print-build-logs \
      --print-out-paths \
      "${closureToplevel}"
  )
else 
    closurePath=$(
    nom build \
      --print-build-logs \
      --print-out-paths \
      --max-jobs 0 \
      --system "${system}" \
      --eval-store auto \
      --store "ssh-ng://${remote_builder}" \
      "${closureToplevel}"
  )
  nix copy --no-check-sigs --from "ssh://${remote_builder}" "${closurePath}"
fi

echo "built ${closurePath} for ${closureToplevel}"

# Resolve hostname to ensure mDNS is ready before nix copy
# Extract hostname from ip_address (might be user@hostname format)
hostname_part="${ip_address##*@}"
echo "Resolving hostname: ${hostname_part}"
# Not fatal: getent fails for ssh aliases and doesn't exist on macOS.
resolved_ip=$(getent hosts "${hostname_part}" 2>/dev/null | awk '{ print $1 }' | head -n1) || true
if [ -z "${resolved_ip}" ]; then
  echo "WARNING: Could not resolve ${hostname_part} (ssh alias?), using original address"
  target_address="${ip_address}"
else
  echo "Resolved ${hostname_part} to ${resolved_ip}"
  # Reconstruct with resolved IP if there was a user@ part
  if [[ "${ip_address}" == *"@"* ]]; then
    user_part="${ip_address%%@*}"
    target_address="${user_part}@${resolved_ip}"
  else
    target_address="${resolved_ip}"
  fi
fi

# Ping the remote host before any further communication. Only a resolved
# address can be pinged; otherwise ssh itself reports an unreachable host.
if [ -n "${resolved_ip}" ]; then
  echo "Pinging remote host: ${resolved_ip}"
  if ! ping -c 2 -W 2 "${resolved_ip}" >/dev/null 2>&1; then
    echo "ERROR: Remote host ${resolved_ip} is unreachable (ping failed). Aborting."
    exit 1
  fi
fi

if [ "${password}" == "" ]; then
  NIX_SSHOPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null" \
    nix copy --no-check-sigs --to "ssh://${target_address}?compress=true" "${closurePath}"
else
  NIX_SSHOPTS="-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null" \
    sshpass -p "${password}" nix copy --no-check-sigs --to "ssh://${target_address}?compress=true" "${closurePath}"
fi

echo "copied ${closurePath} to ${ip_address}"

# Like nixos-rebuild build: stop once the closure is copied, activating nothing.
if [ "${action}" == "build" ]; then
  exit 0
fi

# Run a command as root on the remote. A password goes to sudo on stdin, so it
# needs no quoting and never shows up in the remote's process list; without
# one, -t gives sudo a terminal to prompt on.
remote_sudo() {
  local ssh_opts=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null)
  if [ "${password}" == "" ]; then
    # shellcheck disable=SC2029 # We want to expand the commands on the client side
    ssh -t "${ssh_opts[@]}" "${target_address}" "sudo sh -c '$1'"
  else
    # shellcheck disable=SC2029 # We want to expand the commands on the client side
    sshpass -p "${password}" ssh "${ssh_opts[@]}" "${target_address}" "sudo -S -p '' sh -c '$1'" <<<"${password}"
  fi
}

# Like nixos-rebuild, only switch and boot make this the new system generation;
# test leaves the profile alone. systemd-run (also as nixos-rebuild does) keeps
# the activation alive if it restarts the network and drops this ssh session.
activate="systemd-run --collect --no-ask-password --pipe --quiet --service-type=exec --unit=nixos-rebuild-switch-to-configuration ${closurePath}/bin/switch-to-configuration ${action}"
if [ "${action}" == "switch" ] || [ "${action}" == "boot" ]; then
  activate="nix-env -p /nix/var/nix/profiles/system --set ${closurePath} && ${activate}"
fi
remote_sudo "${activate}"
echo "executed ${action} on asset ${ip_address} with ${closurePath}"

if [ "${action}" == "boot" ]; then
  echo "rebooting asset ${ip_address}"
  remote_sudo reboot
  echo "rebooted asset ${ip_address}"
fi
